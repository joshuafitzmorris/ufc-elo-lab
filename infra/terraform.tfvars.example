# AWS Configuration
aws_account_id = "123456789012"  # REQUIRED: Your AWS account ID (prevents wrong-account deploys)
aws_region     = "us-west-2"
environment    = "prod"

# Database Configuration
db_instance_class = "db.t3.micro"
db_name           = "ufc_elo"
db_username       = "ufcelo"

# ECS Configuration
container_cpu    = 256
container_memory = 512
desired_count    = 1

# Optional: ECR Repository URL (if using external registry)
# ecr_repository_url = "123456789.dkr.ecr.us-east-1.amazonaws.com/ufc-elo:latest"
